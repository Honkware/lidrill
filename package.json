{
  "name": "lidrill",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "bun scripts/copy-engine.mjs",
    "dev": "bun scripts/dev.ts",
    "prebuild": "bun scripts/copy-engine.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "test:golden": "GOLDEN=1 vitest run src/golden.test.ts",
    "test:gate": "GATE=1 vitest run src/gate.test.ts",
    "gate:offline": "bun scripts/offline-gate.ts",
    "stats": "bun scripts/stats.ts"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "chessops": "^0.15.1",
    "dexie": "^4.4.6",
    "snabbdom": "3.5.1",
    "stockfish": "^19.0.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "license": "AGPL-3.0-or-later"
}
