[Unit]
Description=Lidrill cloudflared quick tunnel (127.0.0.1:8010 -> https)
After=lidrill-server.service

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
