{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  // What runs under Node or Bun: the tests, the scripts and the Vite config
  "include": ["src/**/*.test.ts", "worker/**/*.test.ts", "scripts/*.ts", "vite.config.ts"]
}
