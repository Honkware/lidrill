{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lidrill",
  "compatibility_date": "2026-10-01",
  // Static assets, plus a small Worker for /api/* (see worker/index.ts)
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Per-visitor cap on explanations and on packet uploads (its own namespace,
  // higher: uploads are sync-time background traffic); the OpenRouter key is
  // a Worker secret
  "ratelimits": [
    { "name": "EXPLAIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "PACKET_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  // Packet store: key = packetHash, value = packet
  // JSON, TTL 30 days. The id below is a LOCAL dev id (wrangler dev emulates
  // KV). For preview/production run `wrangler kv namespace create PACKETS`
  // (and `--preview` for preview_id) and paste the real ids over the
  // placeholders.
  "kv_namespaces": [
    // wrangler kv namespace create PACKETS  → id; --preview → preview_id
    { "binding": "PACKETS", "id": "5446388847ad569b5fedb046becfded6", "preview_id": "<preview-id>" }
  ],
  "routes": [
    // www.lidrill.org is a proxied DNS record that a zone redirect rule sends here
    { "pattern": "lidrill.org", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
