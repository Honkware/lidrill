{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lidrill",
  "compatibility_date": "2026-10-01",
  // Static assets, plus a small Worker for /api/* (see worker/index.ts)
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Per-visitor cap on explanations and on packet uploads (its own namespace,
  // higher: uploads are sync-time background traffic); the OpenRouter key is
  // a Worker secret
  "ratelimits": [
    { "name": "EXPLAIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "PACKET_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    // A sync cycle is ~12 small requests per device; 240/min per account
    // covers several devices syncing at once
    { "name": "SYNC_LIMIT", "namespace_id": "1003", "simple": { "limit": 240, "period": 60 } },
    // One request per Maia move; a fast game is well under one a second
    { "name": "MAIA_LIMIT", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    // Building an opening tree asks for one position after another; a first
    // tree to 8 moves can need a few hundred, so it gets its own budget
    { "name": "POLICY_LIMIT", "namespace_id": "1005", "simple": { "limit": 300, "period": 60 } },
    // Shared evals: one lookup per 500 games, then one upload for each game
    // the browser had to analyse itself, a few seconds apart
    { "name": "EVALS_LIMIT", "namespace_id": "1006", "simple": { "limit": 120, "period": 60 } }
  ],
  // Packet store: key = packetHash, value = packet
  // JSON, TTL 30 days. Finished explanations live beside the packets under
  // keys that start with why/ (src/server/explainCache.ts), same TTL. Real namespace ids (created 2026-10-06 with
  // `wrangler kv namespace create PACKETS` / `--preview`); wrangler dev
  // emulates KV so local runs ignore them.
  "kv_namespaces": [
    { "binding": "PACKETS", "id": "2442fe2be2e548ebb07922f28e05074b", "preview_id": "6b2c2309b5bf4f58a5cd2c4fdbf8a246" }
  ],
  "routes": [
    // www.lidrill.org is a proxied DNS record that a zone redirect rule sends here
    { "pattern": "lidrill.org", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
